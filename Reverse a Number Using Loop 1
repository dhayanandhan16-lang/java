import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner inn=new Scanner(System.in);
        int a=inn.nextInt();
        if (a<0){
            System.out.println("Invalid Input");
        }
        else{
            int rev=0;
            while(a>0){
                rev=rev*10+(a%10);
                a=a/10;
            }
            System.out.println(rev);
        }
    }
}
