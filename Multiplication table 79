import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner inn=new Scanner (System.in);
        int a=inn.nextInt();
        if(a<=10){
            for(int i=1;i<=5;i++){
                System.out.println(a+" x "+i+" = "+(a*i));
            }
        }
        else {
                System.out.println("Invalid Input");
            }
        }
    }
