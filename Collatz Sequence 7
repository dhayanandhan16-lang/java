import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner inn=new Scanner(System.in);
        System.out.println("Enter a number");
        int n=inn.nextInt();
        int a=0;
        System.out.println(n);
        while(n!=1){
            if (n%2==0){
                n=n/2;
            }
            else{
                n=3*n+1;
            }
            System.out.println(n);
            a++;
        }
        System.out.println("count:"+a);
    }
}
