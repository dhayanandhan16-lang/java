import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner inn=new Scanner (System.in);
        int a=inn.nextInt();
        if (a>=100 || a<=-100){
            int sum=0;
            int t=Math.abs(a);
            while(t>0){
                sum+=t%10;
                t/=10;
            }
            System.out.println("Sum of digit is "+sum);
        }
        else{
            System.out.println("Invalid Input");
        }
    }
}
