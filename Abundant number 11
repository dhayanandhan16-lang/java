import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
       Scanner inn=new Scanner(System.in);
        int a=inn.nextInt();
        int sum=0;
        for(int i=1;i<=a/2;i++){
            if(a % i==0){
                sum+=i;
            }
        }
        if(sum>a){
            System.out.println("Abundant Number");
        }
            else{
                System.out.println("Not Abundant Number");
            }
        }
    }
